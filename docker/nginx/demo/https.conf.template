# Con certificado de Let's Encrypt: HTTP solo redirige a HTTPS.
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DEMO_DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DEMO_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DEMO_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DEMO_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:5m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/sicco/app.conf;
}
