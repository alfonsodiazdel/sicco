APP_NAME=SICCO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sicco
DB_USERNAME=sicco
DB_PASSWORD=sicco
# Producción (Managed Database de DigitalOcean): puerto 25060 + TLS
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/do-ca-certificate.crt

SESSION_DRIVER=database
# CU01: la sesión expira tras 30 minutos de inactividad
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Orígenes de la SPA que usan sesión por cookie (Sanctum)
SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@sicco.app"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (producción): MAIL_MAILER=resend y la API key. Con resend se ignoran MAIL_HOST/PORT/USERNAME/PASSWORD.
RESEND_API_KEY=

# Almacenamiento S3: SeaweedFS en local, DigitalOcean Spaces en producción.
# Spaces: AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com, AWS_DEFAULT_REGION=nyc3,
#         AWS_USE_PATH_STYLE_ENDPOINT=false y las llaves de acceso de Spaces.
AWS_ACCESS_KEY_ID=sicco
AWS_SECRET_ACCESS_KEY=sicco-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sicco
AWS_ENDPOINT=http://s3:8333
AWS_URL=http://localhost:8333/sicco
AWS_USE_PATH_STYLE_ENDPOINT=true

# CU07 Leer guía con OCR (Claude con visión y salida estructurada).
# OCR_DRIVER=fake devuelve siempre la misma guía sin llamar a la API (desarrollo y pruebas);
# OCR_DRIVER=claude usa la API de Anthropic. La API key se crea en https://platform.claude.com
# (Settings → API keys) y no se sube al repositorio.
OCR_DRIVER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_OCR_MODEL=claude-opus-5-5
# Segundos de espera antes de pasar al registro manual (CU07: 20 s).
OCR_TIMEOUT=20
# Los campos con confianza menor se marcan para revisión.
OCR_UMBRAL_CONFIANZA=0.8
# Lecturas por minuto y usuario (cada lectura tiene costo en la API).
OCR_POR_MINUTO=20
# Exportaciones en ZIP por minuto y usuario (CU18).
EXPORTACIONES_POR_MINUTO=5

