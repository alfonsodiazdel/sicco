# Variables del Droplet de demostración (docker-compose.demo.yml).
# deploy/deploy.sh copia este archivo a backend/.env la primera vez y genera
# las contraseñas de la base de datos. Revisa los valores marcados con "CAMBIAR".

# --- Servidor (las usa docker compose, Laravel las ignora) ---
# Dominio que apunta al Droplet (registro A). Vacío = solo HTTP por IP.
DEMO_DOMAIN=CAMBIAR.sicco.app
# Correo para avisos de Let's Encrypt (vencimiento del certificado).
LETSENCRYPT_EMAIL=CAMBIAR@correo.com
# Acceso a https://<dominio>/mailpit/ con formato usuario:contraseña
MAILPIT_UI_AUTH=jurado:CAMBIAR
DB_ROOT_PASSWORD=

# Contraseña temporal de los usuarios demo (UsuarioDemoProduccionSeeder).
# Mínimo 8 caracteres con letras y números; se cambia en el primer ingreso.
DEMO_PASSWORD=

APP_NAME=SICCO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CAMBIAR.sicco.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sicco
DB_USERNAME=sicco
DB_PASSWORD=

SESSION_DRIVER=database
# CU01: la sesión expira tras 30 minutos de inactividad
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true con HTTPS; false si la demo corre solo por IP (HTTP)
SESSION_SECURE_COOKIE=true

# La SPA y la API comparten dominio (nginx sirve ambas)
SANCTUM_STATEFUL_DOMAINS=CAMBIAR.sicco.app
FRONTEND_URL=https://CAMBIAR.sicco.app

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@sicco.app"
MAIL_FROM_NAME="${APP_NAME}"

# SeaweedFS dentro del Droplet (no se expone a internet).
AWS_ACCESS_KEY_ID=sicco
AWS_SECRET_ACCESS_KEY=sicco-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sicco
AWS_ENDPOINT=http://s3:8333
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# CU07 OCR con Claude: para leer guías reales, OCR_DRIVER=claude y la API key de
# https://platform.claude.com (Settings → API keys). Con fake, la lectura es siempre la misma guía.
OCR_DRIVER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_OCR_MODEL=claude-opus-5-5
